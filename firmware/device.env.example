# Device settings for serial provisioning (host/provision.py), the
# phone-free way to set up a device. Copy to firmware/device.env (gitignored)
# and fill in; never commit real values (AGENTS.md rule 2). The phone setup
# portal writes the same settings (firmware/include/settings.h).
ssid="your-network-name"
# Blank = open network.
pass="your-network-password"
# host or host:port (default port 8642).
hermes="your-workstation-host"
# One agent: an existing Hermes profile and its API key. Provisioning adds it
# to the device's agents (up to 4; others stay) and makes it the one in use.
key="your-scoped-key"
# Blank = the gateway's default profile.
profile=""
# Blank = the hermes host, port 8643.
shim=""
# Venice backend mode instead of Hermes: backend="venice" plus the API key
# from venice.ai. ssid/pass still join the home WiFi; the Hermes members are
# ignored in this mode (they stay stored for a switch back).
# backend="venice"
# veniceKey="your-venice-key"
# Blank = https://api.venice.ai:443; http://host:port names a bench test server.
# venice=""
